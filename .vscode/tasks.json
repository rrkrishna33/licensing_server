{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Licensing Server: Dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"group": "build",
